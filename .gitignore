# Vite build output, generated by `npm run build` (react-app/) directly
# into the plugin folder. Not committed — see README for the build step.
# (Not a plain .gitignore *inside* that folder: Vite's emptyOutDir wipes
# the directory's contents on every build, which would delete it there.)
wordpress-plugin/events-showcase/assets/build/

# Distributable plugin zip (built on demand for wp-admin upload installs).
wordpress-plugin/*.zip
